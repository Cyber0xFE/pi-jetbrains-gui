<idea-plugin>
    <id>dev.pi.jetbrains</id>
    <name>Pi Jetbrains GUI</name>
    <vendor url="https://github.com/Cyber0xFE/pi-jetbrains-gui">Cyber0xFE</vendor>
    <description><![CDATA[
        JetBrains IDE 内 pi coding agent（<a href="https://github.com/badlogic/pi-mono">pi</a>）的图形化前端。<br><br>

        <b>功能特性</b>
        <ul>
            <li>内置 Pi 工具窗口，直接在 IDE 内与 pi coding agent 对话</li>
            <li>会话持久化与进程恢复，重启 IDE 后可继续历史会话</li>
            <li>受保护的工具输出展示（读文件、终端、补丁等）</li>
            <li>IDE 主题集成，界面跟随编辑器明暗主题自动切换</li>
            <li>自动识别编辑器选中的区域，作为上下文附到对话中</li>
            <li>可配置 pi CLI 路径与工作目录</li>
        </ul>

        <b>使用前提</b>：本机已安装 pi CLI（<code>npm install -g @mariozechner/pi</code>）。<br><br>

        源码与问题反馈：<a href="https://github.com/Cyber0xFE/pi-jetbrains-gui">https://github.com/Cyber0xFE/pi-jetbrains-gui</a>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>

    <actions>
        <action id="dev.pi.jetbrains.SendConsoleSelectionToPi" class="dev.pi.jetbrains.editor.SendConsoleSelectionToPiAction" icon="/icons/toolWindowPi.png">
            <add-to-group group-id="ConsoleView.PopupMenu" anchor="last"/>
        </action>
    </actions>

    <extensions defaultExtensionNs="com.intellij">
        <projectService serviceImplementation="dev.pi.jetbrains.PiChatService"/>
        <applicationConfigurable instance="dev.pi.jetbrains.ui.PiSettingsConfigurable"/>
        <toolWindow
                id="Pi"
                anchor="right"
                icon="/icons/toolWindowPi.png"
                factoryClass="dev.pi.jetbrains.ui.ChatToolWindowFactory"/>
    </extensions>
</idea-plugin>
