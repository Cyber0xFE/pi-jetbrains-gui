<idea-plugin>
    <id>dev.pi.jetbrains</id>
    <name>pi-jetbrains-gui</name>
    <vendor>pi</vendor>
    <description>Graphical front-end for the pi coding agent inside JetBrains IDEs.</description>

    <depends>com.intellij.modules.platform</depends>

    <actions>
        <action id="dev.pi.jetbrains.SendToPi" class="dev.pi.jetbrains.editor.SendToPiAction">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
        </action>
    </actions>

    <extensions defaultExtensionNs="com.intellij">
        <projectService serviceImplementation="dev.pi.jetbrains.PiChatService"/>
        <applicationConfigurable instance="dev.pi.jetbrains.ui.PiSettingsConfigurable"/>
        <toolWindow
                id="pi"
                anchor="right"
                icon="AllIcons.Toolwindows.ToolWindowMessages"
                factoryClass="dev.pi.jetbrains.ui.ChatToolWindowFactory"/>
    </extensions>
</idea-plugin>
